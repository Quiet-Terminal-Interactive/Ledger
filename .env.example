# Real hostname pointing at this server, e.g. ledger.qti.internal. Defaults to "localhost", which gets you a self-signed cert (browser warning, but works) with zero config.
LEDGER_DOMAIN=
# Contact address for Let's Encrypt expiry notices (optional).
LEDGER_ACME_EMAIL=

POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=

# Base64-encoded key, at least 256 bits. Generate with: openssl rand -base64 32
JWT_SECRET=
# 30 days, in ms (optional).
JWT_EXPIRATION_MS=2592000000

# First-run only: creates the initial admin account. Ignored once any credentials exist,
# so it's safe to leave these set after first boot.
LEDGER_ADMIN_USERNAME=
LEDGER_ADMIN_PASSWORD=
LEDGER_ADMIN_FIRST_NAME=Admin
LEDGER_ADMIN_LAST_NAME=User

LEDGER_GIT_URL=
LEDGER_GIT_API_TOKEN=
# Comma-separated Git usernames whose PUBLIC repos are shown.
LEDGER_GIT_LISTED_USERS=

LEDGER_MINIO_ACCESS_KEY=
LEDGER_MINIO_SECRET_KEY=
# Comma-separated bucket names; docker-compose's minio-init service creates these on startup.
LEDGER_MINIO_BUCKETS=ledger-uploads

LEDGER_DISCORD_ENABLED=false
LEDGER_DISCORD_WEBHOOK_URL=

LEDGER_GMAIL_ENABLED=false
LEDGER_GMAIL_CLIENT_ID=
LEDGER_GMAIL_CLIENT_SECRET=
LEDGER_GMAIL_REFRESH_TOKEN=

LEDGER_BUDGET_CURRENCY=USD

LEDGER_LOGO_URL=

# Requires pg_dump and git on PATH inside the container, plus repo-dir already cloned with push credentials configured. Not wired into docker-compose.yml by default, mount a volume with the clone and SSH deploy key onto the app service if you enable this.
LEDGER_BACKUP_ENABLED=false
LEDGER_BACKUP_CRON=0 0 3 * * *
LEDGER_BACKUP_REPO_DIR=
LEDGER_BACKUP_GIT_REMOTE=origin
LEDGER_BACKUP_GIT_BRANCH=main
